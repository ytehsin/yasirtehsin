{
  "id": "_base",
  "name": "Base defaults",
  "_note": "Every template merges over this. A template only declares what it changes, so adding a new engine variable does not require touching 15 template files. Values here are deliberately plain — this is a working book, not a designed one.",

  "page": {
    "widthMm": 139.7,
    "heightMm": 215.9,
    "marginTopMm": 18,
    "marginBottomMm": 20,
    "marginInnerMm": 20,
    "marginOuterMm": 16,
    "bleedMm": 0
  },

  "runningHead": {
    "verso": "author",
    "recto": "chapter",
    "sizePt": 8.5,
    "tracking": "0.06em",
    "transform": "uppercase",
    "family": "body"
  },

  "folio": {
    "position": "outer",
    "location": "foot",
    "sizePt": 9.5,
    "figures": "oldstyle"
  },

  "vars": {
    "body-family": "'Source Serif 4', Georgia, serif",
    "display-family": "'Source Serif 4', Georgia, serif",
    "heading-family": "var(--display-family)",
    "mono-family": "'IBM Plex Mono', monospace",

    "body-size": "10.5pt",
    "leading": "1.5",
    "body-weight": "400",
    "body-align": "justify",
    "body-figures": "oldstyle-nums proportional-nums",
    "hyphenation": "auto",
    "orphans": "2",
    "widows": "2",
    "indent": "1.2em",

    "ink": "#141414",
    "ink-muted": "#5a5a5a",
    "accent": "#141414",
    "rule-color": "#b9b9b9",
    "rule-hairline": "0.4pt",
    "rule-medium": "0.9pt",

    "block-break": "page",
    "opener-sinkage": "22%",
    "opener-sinkage-plain": "14%",
    "opener-space-after": "2.4rem",
    "opener-align": "left",

    "opener-number-size": "9pt",
    "opener-number-weight": "400",
    "opener-number-tracking": "0.18em",
    "opener-number-transform": "uppercase",
    "opener-number-figures": "lining-nums",
    "opener-number-gap": "1.4rem",

    "opener-title-size": "20pt",
    "opener-title-weight": "400",
    "opener-title-leading": "1.15",
    "opener-title-tracking": "0",
    "opener-title-transform": "none",

    "initial-lines": "1",
    "initial-family": "inherit",
    "initial-weight": "inherit",
    "initial-color": "inherit",
    "initial-gap": "0",

    "heading-weight": "600",
    "heading-leading": "1.2",
    "heading-align": "left",
    "h1-size": "1.25rem",
    "h1-space-before": "1.8rem",
    "h1-space-after": "0.7rem",
    "h2-size": "1.08rem",
    "h2-space-before": "1.4rem",
    "h2-space-after": "0.5rem",
    "h3-size": "1rem",
    "h3-space-before": "1.1rem",
    "h3-space-after": "0.35rem",
    "h3-style": "italic",

    "quote-space-before": "1rem",
    "quote-space-after": "1rem",
    "quote-inset-left": "2em",
    "quote-inset-right": "2em",
    "quote-size": "0.94em",
    "quote-leading": "1.45",
    "quote-style": "normal",

    "epigraph-space-before": "0",
    "epigraph-space-after": "2.2rem",
    "epigraph-inset-left": "4em",
    "epigraph-inset-right": "0",
    "epigraph-size": "0.92em",
    "epigraph-style": "italic",
    "epigraph-align": "left",
    "attribution-gap": "0.5rem",
    "attribution-size": "0.86em",
    "attribution-style": "normal",
    "attribution-align": "right",

    "verse-space-before": "1rem",
    "verse-space-after": "1rem",
    "verse-inset": "2em",
    "verse-runover": "1.5em",
    "verse-step": "1.5em",

    "list-space-before": "0.8rem",
    "list-space-after": "0.8rem",
    "list-inset": "1.6em",
    "list-item-gap": "0.3rem",

    "scene-space": "1.4rem",
    "scene-glyph": "'* * *'",
    "scene-size": "0.9em",
    "scene-tracking": "0.3em",

    "figure-space-before": "1.2rem",
    "figure-space-after": "1.2rem",
    "figure-full-bleed": "0mm",
    "caption-gap": "0.5rem",
    "caption-family": "var(--body-family)",
    "caption-size": "0.84em",
    "caption-leading": "1.35",
    "caption-style": "normal",
    "caption-align": "left",

    "table-space-before": "1.2rem",
    "table-space-after": "1.2rem",
    "table-size": "0.9em",
    "table-leading": "1.35",
    "table-caption-side": "top",
    "table-head-weight": "600",
    "cell-padding": "0.35em 0.6em 0.35em 0",

    "code-size": "0.85em",
    "code-leading": "1.4",
    "code-space-before": "1rem",
    "code-space-after": "1rem",
    "code-padding": "0.6em 0.8em",
    "code-bg": "#f4f4f2",

    "footnote-size": "0.8em",
    "footnote-leading": "1.3",
    "footnote-call-size": "0.7em",
    "footnote-marker-gap": "0.4em",
    "footnote-rule-gap": "0.5em",

    "sc-variant": "small-caps",
    "sc-fallback-size": "1em",
    "sc-fallback-transform": "none",
    "sc-tracking": "0.04em",

    "link-decoration": "none",

    "leading-devanagari": "1.85",
    "leading-bengali": "1.8",
    "leading-tamil": "1.9",
    "leading-telugu": "1.9",
    "leading-malayalam": "1.9",
    "leading-gujarati": "1.8",
    "leading-gurmukhi": "1.8",
    "leading-nastaliq": "2.2",

    "toc-entry-gap": "0.55rem",
    "toc-family": "var(--body-family)",
    "toc-leader-gap": "0.5em",
    "toc-indent": "1.5em",
    "toc-l2-size": "0.94em",
    "toc-l3-size": "0.88em",

    "preview-bg": "#e8e6e1",
    "preview-gap": "16px"
  }
}
