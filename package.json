{
  "name": "zope-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ZOPE: manuscript to print-ready PDF and EPUB. Engine plus a working web app.",
  "scripts": {
    "dev": "tsx app/server.ts",
    "start": "tsx app/server.ts",
    "fixtures": "node test/generate-fixtures.mjs test/fixtures",
    "test:detect": "tsx test/eval.ts test/fixtures",
    "test:roundtrip": "tsx test/roundtrip.ts test/fixtures",
    "test:render": "tsx test/render-roundtrip.ts test/fixtures",
    "test": "npm run test:detect && npm run test:roundtrip && npm run test:render",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "fast-xml-parser": "^4.5.0",
    "jsdom": "^25.0.0",
    "jszip": "^3.10.1",
    "mammoth": "^1.8.0",
    "pagedjs": "^0.4.3",
    "playwright": "^1.48.0",
    "prosemirror-model": "^1.23.0"
  },
  "devDependencies": {
    "docx": "^9.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0",
    "@types/jsdom": "^21.1.7"
  },
  "engines": {
    "node": ">=20"
  }
}